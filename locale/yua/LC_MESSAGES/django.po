msgid ""
"El mejor individuo obtenido en la última iteración se valida y su estructura"
" interna se almacena como el calendario definitivo del torneo de béisbol."
msgstr ""

#: tesis/templates/tesis/dashboard.html
msgid "Tesis de Ingeniería en Computación"
msgstr ""
