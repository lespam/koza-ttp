msgstr "Paraprake"

#: tesis/templates/tesis/inicio.html
msgid "Motor mejorado"
msgstr "Motor i përmirësuar"

#: tesis/templates/tesis/inicio.html
msgid "En revisión"
msgstr "Në Rishikim"

#: tesis/templates/tesis/inicio.html
msgid "Traducciones"
msgstr "Përkthime"

