msgstr "Ga naar de hoofdsite"

#: documentacion/templates/documentacion/base.html
msgid "Menú"
msgstr "Menu"

#: documentacion/templates/documentacion/base.html
msgid "Cómo funciona"
msgstr "Hoe het werkt"

