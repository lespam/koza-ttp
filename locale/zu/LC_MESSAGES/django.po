msgstr "Isisekelo esifanele sokulinganisa i-PG."

#: documentacion/templates/documentacion/investigacion.html
msgid "Turnos + semana + recocido hecho a mano"
msgstr "Ama-shifts + isonto + i-annealing eyenziwe ngezandla"

#: documentacion/templates/documentacion/investigacion.html
msgid "1.567 millones de km (promedio de 8 calendarios)"
msgstr "Amakhilomitha ayizigidi eziyi-1.567 (isilinganiso samakhalenda ayi-8)"

#: documentacion/templates/documentacion/investigacion.html
msgid "Aceptar cambios peores al principio ayuda mucho."
msgstr "Ukwamukela izinguquko ezimbi kakhulu ekuqaleni kusiza kakhulu."

#: documentacion/templates/documentacion/investigacion.html
msgid "Turnos + semana + PG que aprende la temperatura"
msgstr "Ama-shifts + isonto + izinga lokushisa lokufunda le-PG"

#: documentacion/templates/documentacion/investigacion.html
msgid "1.571 millones de km (promedio de 8 calendarios)"
msgstr "Amakhilomitha ayizigidi eziyi-1.571 (isilinganiso samakhalenda ayi-8)"

#: documentacion/templates/documentacion/investigacion.html
msgid ""
"La PG diseña su propia regla y casi empata con la hecha a mano (0.3 %% más)."
msgstr ""
"I-PG yakha umbusi wayo futhi icishe ihlanganise naleyo eyenziwe ngezandla "
