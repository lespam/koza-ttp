msgstr "น่าจะข้ามไป"

#: documentacion/templates/documentacion/historico.html
msgid "Prob. de mutación"
msgstr "น่าจะเป็นการกลายพันธุ์"

#: documentacion/templates/documentacion/historico.html
msgid "Viabilidad (C1)"
msgstr "ความเป็นไปได้ (C1)"

#: documentacion/templates/documentacion/historico.html
msgid "Distancia total (C2)"
msgstr "ระยะทางรวม (C2)"

#: documentacion/templates/documentacion/historico.html
