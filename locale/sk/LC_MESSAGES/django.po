msgstr "2 minúty"

#: tesis/templates/tesis/inicio.html
msgid "Entender la idea"
msgstr "Pochopenie myšlienky"

#: tesis/templates/tesis/inicio.html
msgid "Empezar aquí"
msgstr "Začni tu"

#: tesis/templates/tesis/inicio.html
msgid "5 minutos · 5 pasos"
msgstr "5 minút · 5 krokov"

#: tesis/templates/tesis/inicio.html
msgid "Probar la herramienta"
msgstr "Vyskúšajte nástroj"

#: tesis/templates/tesis/inicio.html
msgid ""
"Registra equipos, arma una liga y genera tu propio calendario. Sin cuenta."
msgstr ""
"Zaregistrujte tímy, vytvorte ligu a vytvorte si vlastný kalendár. Žiadny "
