msgstr "Pravdepodobne. prechodu"

#: documentacion/templates/documentacion/historico.html
msgid "Prob. de mutación"
msgstr "Pravdepodobne. mutácie"

#: documentacion/templates/documentacion/historico.html
msgid "Viabilidad (C1)"
msgstr "Uskutočniteľnosť (C1)"

#: documentacion/templates/documentacion/historico.html
