msgstr ""
"Une explication avec la carte des 30 stades, des arbres et de l’évolution, "
"étape par étape."

#: documentacion/templates/documentacion/avances.html
msgid "Leer la historia"
msgstr "Lisez l’histoire"

#: documentacion/templates/documentacion/avances.html
msgid "Segunda auditoría de la experiencia"
msgstr "Deuxième audit de l’expérience"

#: documentacion/templates/documentacion/avances.html
