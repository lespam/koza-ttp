msgid "Fecha"
msgstr "Päivämäärä"

#: tesis/templates/tesis/dashboard.html
msgid "Local"
msgstr "Paikallinen"

#: tesis/templates/tesis/dashboard.html
msgid "Visitante"
msgstr "Pois"

