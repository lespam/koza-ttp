msgstr "Voit käyttää olemassa olevia tai lisätä uuden."

#: tesis/templates/tesis/guia/equipos.html
msgid "Ver los últimos equipos registrados"
msgstr "Katso uusimmat rekisteröidyt joukkueet"

#: tesis/templates/tesis/guia/equipos.html
