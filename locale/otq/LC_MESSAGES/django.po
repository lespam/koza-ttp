msgstr "Ma jar hmä"

#: tesis/templates/tesis/inicio.html
msgid "Qué tan confiable es cada parte"
msgstr "Temu̲ ar confiable kadu̲ 'nar xeni"

#: tesis/templates/tesis/inicio.html
msgid "Para que sepas qué puedes citar y qué todavía cambia."
msgstr "Nja'bu da gí mfädi nä'ä tsa̲ da citar ne nä'ä Tobe cambia."

#: tesis/templates/tesis/inicio.html
msgid "Final"
msgstr "Ar ngäts'i"

#: tesis/templates/tesis/inicio.html
