#: documentacion/templates/documentacion/avances.html
msgid "Avances: después de la tesis"
msgstr "Tiến bộ: sau luận văn"

#: documentacion/templates/documentacion/avances.html
msgid ""
"Aquí se registra cada cambio hecho después de la defensa. La versión de la "
"tesis se conserva sin cambios, para poder comparar."
msgstr ""
"Ở đây, mọi thay đổi được thực hiện sau khi bảo vệ đều được ghi lại. Phiên "
"bản luận điểm được giữ nguyên để có thể so sánh."

#: documentacion/templates/documentacion/avances.html
msgid "Versiones del motor"
msgstr "Phiên bản động cơ"

#: documentacion/templates/documentacion/avances.html
msgid "Versión de la tesis y versión mejorada"
msgstr "Phiên bản luận văn và phiên bản cải tiến"

#: documentacion/templates/documentacion/avances.html
msgid "Versión"
msgstr "Phiên bản"

#: documentacion/templates/documentacion/avances.html
msgid "Estado"
msgstr "Tình trạng"

#: documentacion/templates/documentacion/avances.html
msgid "Distancia total (30 equipos)"
msgstr "Tổng quãng đường (30 đội)"

#: documentacion/templates/documentacion/avances.html
