msgstr "Prob. ya kuvuka"

#: documentacion/templates/documentacion/historico.html
msgid "Prob. de mutación"
msgstr "Prob. ya mabadiliko"

#: documentacion/templates/documentacion/historico.html
msgid "Viabilidad (C1)"
msgstr "Yakinifu (C1)"

#: documentacion/templates/documentacion/historico.html
msgid "Distancia total (C2)"
msgstr "Jumla ya umbali (C2)"

