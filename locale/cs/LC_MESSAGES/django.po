#: tesis/templates/tesis/dashboard.html
msgid "Fecha"
msgstr "Datum"

#: tesis/templates/tesis/dashboard.html
msgid "Local"
msgstr "Místní"

#: tesis/templates/tesis/dashboard.html
msgid "Visitante"
msgstr "Pryč"

