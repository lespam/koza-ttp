"aaye 28 fun ilọsiwaju. Yoo tun ṣe nigbati ẹrọ tuntun ba ṣetan."

#: documentacion/templates/documentacion/avances.html
msgid "Leer la auditoría"
msgstr "Ka awọn ayewo"

#: documentacion/templates/documentacion/avances.html
