msgid "Pídele ayuda a tu asistente de IA"
msgstr "Beere lọwọ oluranlọwọ AI rẹ fun iranlọwọ"

#: tesis/templates/tesis/dashboard.html
msgid ""
"Explícame paso a paso cómo este programa genético crea y evalúa un "
"calendario. Luego dime qué cambiaría para que la medida de “viaje justo” sea"
" la diferencia entre el equipo que más viaja y el que menos."
msgstr ""
"Ṣalaye fun mi ni igbesẹ-nipasẹ-igbesẹ bi eto jiini yii ṣe ṣẹda ati ṣe ayẹwo "
"iṣeto kan. Lẹhinna sọ fun mi ohun ti iwọ yoo yipada ki iwọn ti \"irin-ajo "
"ododo\" jẹ iyatọ laarin ẹgbẹ ti o rin irin-ajo julọ ati ọkan ti o rin irin-"
"ajo ti o kere julọ."

#: tesis/templates/tesis/dashboard.html
msgid "Revisa lo que te responda contra el código. La IA puede equivocarse."
msgstr "Ṣayẹwo ohun ti o sọ fun ọ lodi si koodu naa. AI le ṣe aṣiṣe."

#: tesis/templates/tesis/dashboard.html
msgid "Cerrar"
msgstr "Close"

