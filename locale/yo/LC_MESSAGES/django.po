msgid ""
"Equipos y coordenadas se registran en la guía. Una idea para tu equipo: usar"
" el patrón Strategy para la medida de “viaje justo”."
msgstr ""
"Awọn ẹgbẹ ati awọn ipoidojuko ni a ṣe igbasilẹ ninu itọsọna naa. Ero fun "
"ẹgbẹ rẹ: lo ilana ilana fun wiwọn \"irin-ajo ododo\"."

#: tesis/templates/tesis/dashboard.html
msgid "¿Puedo usarlo?"
msgstr "Ṣe Mo le lo?"

#: tesis/templates/tesis/dashboard.html
msgid "Sí, con GPL-3.0"
msgstr "Bẹẹni, pẹlu GPL-3.0"

#: tesis/templates/tesis/dashboard.html
msgid "Puedes modificarlo. Conserva el crédito y cita la tesis."
msgstr "O le ṣatunṣe rẹ. Pa kirẹditi naa ki o tọka si iwe-akọọlẹ naa."

#: tesis/templates/tesis/dashboard.html
msgid "Cómo citar"
msgstr "Bii o ṣe le tọka si"

