msgstr "Nke a bụ azịza ndị a ga-ajụ gị na klas."

#: tesis/templates/tesis/dashboard.html
msgid "¿Dónde está la IA?"
msgstr "Ebee ka AI dị?"

#: tesis/templates/tesis/dashboard.html
msgid ""
"Un calendario es un árbol que evoluciona. El código está en "
"<code>programa_genetico/</code> y usa la biblioteca DEAP."
msgstr ""
"Kalenda bụ osisi na-agbanwe agbanwe. Koodu ahụ dị n'ime "
"<code>programa_genetico/</code> ma jiri ọbá akwụkwọ DEAP."

