msgstr "Továbbfejlesztett motor"

#: tesis/templates/tesis/inicio.html
msgid "En revisión"
msgstr "Áttekintésben"

#: tesis/templates/tesis/inicio.html
msgid "Traducciones"
msgstr "Fordítások"

#: tesis/templates/tesis/inicio.html
msgid "Automáticas, incluidas maya y otomí. Puedes corregirlas."
msgstr "Automatikus, beleértve Mayat és Otomít is. Meg tudod javítani őket."

#: documentacion/templates/documentacion/avances.html
msgid "Frente a la búsqueda aleatoria"
msgstr "A véletlenszerű keresés ellen"

#: documentacion/templates/documentacion/avances.html
msgid "¿Es mejor que elegir al azar?"
msgstr "Jobb, mint véletlenszerűen választani?"

#: documentacion/templates/documentacion/avances.html
msgid "En pruebas"
msgstr "Tesztelés során"

#: documentacion/templates/documentacion/avances.html
