msgstr "מה שאתה יוצר כאן נראה על ידי כל מבקר באתר. אל תכתוב נתונים אישיים."

#: tesis/templates/tesis/guia/inicio.html
msgid "Empezar"
msgstr "תתחילו"

#: tesis/templates/tesis/guia/liga.html
msgid "Paso 2: liga"
msgstr "שלב 2: קשר"

#: tesis/templates/tesis/guia/liga.html
