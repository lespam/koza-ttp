msgstr ""
"Apa yang anda cipta di sini akan dilihat oleh mana-mana pelawat laman ini. "
"Jangan tulis data peribadi."

#: tesis/templates/tesis/guia/inicio.html
msgid "Empezar"
msgstr "Mulakan"

